# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# ---- Model provider selection ----
# Which provider the testbed agents call. Swappable by config, not code.
# Supported: anthropic | openai | deepseek | gemini | openrouter | groq
MODEL_PROVIDER=deepseek

# ---- Provider API keys (only the swept providers' keys are required) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ---- Default model IDs per provider (override in config.yaml if desired) ----
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4o-mini
# DeepSeek is OpenAI-compatible; use deepseek-chat for the tool-based rungs.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Gemini via its OpenAI-compatible endpoint (supports function calling).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter: one key -> many open models. Groq: cheap/fast Llama/Qwen/Kimi.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Prevalence data collection (read-only public metadata) ----
# A GitHub token raises the search API rate limit. Read-only scope is enough.
GITHUB_TOKEN=

# ---- Harness behavior ----
# Seconds between model calls, to stay under provider rate limits.
REQUEST_DELAY_SECONDS=1.0
# Max retries on transient (429/5xx) errors.
MAX_RETRIES=5
